---
import Banner from "../components/Banner.astro";
import "../styles/global.css";

const {
    title = "Daniel Ward",
    description = "Portfolio for Daniel Ward.",
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="description" content={description} />
        <title>{title}</title>
        <slot name="head" />
    </head>
    <body>
        <Banner />
        <main>
            <slot />
        </main>
        <script>
            function normaliseProseLinks() {
                const links = document.querySelectorAll(".prose a");
                links.forEach((a) => {
                    let href = a.getAttribute("href");
                    if (!href) return;

                    const isRelativePath = href.startsWith("/") || href.startsWith("#");
                    const hasProtocol = href.startsWith("http://") || href.startsWith("https://") || href.startsWith("mailto:") || href.startsWith("tel:");

                    if (!isRelativePath && !hasProtocol && href.includes(".")) {
                        href = "https://" + href;
                        a.setAttribute("href", href);
                    }

                    if (href.startsWith("http://") || href.startsWith("https://")) {
                        a.setAttribute("target", "_blank");
                        a.setAttribute("rel", "noopener noreferrer");
                    }
                });
            }

            normaliseProseLinks();
            document.addEventListener("astro:page-load", normaliseProseLinks);
        </script>
    </body>
</html>
