---
import Banner from "../components/Banner.astro";
import "../styles/global.css";
import Footer from "../components/Footer.astro";
import { themeInitScript } from "../lib/theme.ts";
import Analytics from "@vercel/analytics/astro";
import SpeedInsights from "@vercel/speed-insights/astro";

const { title = "Daniel Ward", description = "Portfolio for Daniel Ward." } =
  Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta
      name="google-site-verification"
      content="b1QXelDmsc5uLVZgj6tt2wQKUPV2WEb-rA7FcvIbnAI"
    />
    <title>{title}</title>
    <link rel="icon" href="/favicon.ico" />

    <script is:inline set:html={themeInitScript} />

    <slot name="head" />
    <Analytics />
    <SpeedInsights />
<script defer src="https://cloud.umami.is/script.js" data-website-id="8758d9f1-e885-40dc-8237-c033f292ec09" data-performance="true"></script>
  </head>
  <body>
    <Banner />
    <main>
      <slot />
    </main>
    <slot name="extras" />
    <Footer />
  </body>
</html>
