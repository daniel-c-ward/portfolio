---
interface Props {
  prefix?: string;
}

const { prefix = "ts" } = Astro.props;
const id = (name: string) => `${prefix}-${name}`;
---

<div class="ts-demo">
  <div class="ts-demo__card" id={id("pess")}>
    <span class="ts-demo__approach">Pessimistic</span>
    <div class="ts-demo__setting">
      <div>
        <p class="ts-demo__title">Email notifications</p>
        <p class="ts-demo__desc">Receive updates about your account</p>
      </div>
      <button class="ts-demo__toggle" id={id("pess-toggle")} role="switch" aria-checked="false">
        <span class="ts-demo__knob"></span>
      </button>
    </div>
    <div class="ts-demo__status" id={id("pess-status")}>Toggle the switch to try it</div>
    <div class="ts-demo__code">fetch /api/settings &rarr; update UI</div>
  </div>

  <div class="ts-demo__card" id={id("opt")}>
    <span class="ts-demo__approach">Optimistic</span>
    <div class="ts-demo__setting">
      <div>
        <p class="ts-demo__title">Email notifications</p>
        <p class="ts-demo__desc">Receive updates about your account</p>
      </div>
      <button class="ts-demo__toggle" id={id("opt-toggle")} role="switch" aria-checked="false">
        <span class="ts-demo__knob"></span>
      </button>
    </div>
    <div class="ts-demo__status" id={id("opt-status")}>Toggle the switch to try it</div>
    <div class="ts-demo__code">update UI &rarr; fetch /api/settings &rarr; reconcile</div>
  </div>
</div>

<style>
  .ts-demo {
    display: flex;
    gap: 2rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .ts-demo__card {
    flex: 1 1 300px;
    max-width: 360px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 1.5rem;
    box-shadow: var(--shadow-sm);
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .ts-demo__approach {
    font-size: 0.75rem;
    font-weight: var(--weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-subtle);
    align-self: flex-start;
    padding: 0.25rem 0.75rem;
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--color-primary) 10%, transparent);
  }

  .ts-demo__setting {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .ts-demo__title {
    margin: 0;
    font-weight: var(--weight-semibold);
    font-size: var(--text-body);
  }

  .ts-demo__desc {
    margin: 0.25rem 0 0;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .ts-demo__toggle {
    flex-shrink: 0;
    position: relative;
    width: 3rem;
    height: 1.6rem;
    border-radius: var(--radius-pill);
    border: none;
    background: color-mix(in srgb, var(--color-foreground) 20%, transparent);
    cursor: pointer;
    transition: background var(--transition-base);
    padding: 0;
  }

  .ts-demo__toggle[aria-checked="true"] {
    background: var(--color-primary);
  }

  .ts-demo__toggle:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 3px;
  }

  .ts-demo__knob {
    position: absolute;
    top: 0.2rem;
    left: 0.2rem;
    width: 1.2rem;
    height: 1.2rem;
    border-radius: 50%;
    background: var(--color-on-primary);
    transition: transform var(--transition-base), background var(--transition-base);
  }

  .ts-demo__toggle[aria-checked="true"] .ts-demo__knob {
    transform: translateX(1.4rem);
  }

  .ts-demo__toggle--loading {
    opacity: 0.5;
    pointer-events: none;
  }

  .ts-demo__toggle--loading .ts-demo__knob {
    animation: ts-pulse 0.6s ease-in-out infinite alternate;
  }

  @keyframes ts-pulse {
    from { opacity: 0.4; }
    to   { opacity: 1; }
  }

  .ts-demo__status {
    font-size: var(--text-sm);
    line-height: 1.5;
    min-height: 2.5rem;
    color: var(--color-text-muted);
  }

  .ts-demo__status--success {
    color: var(--color-primary);
    font-weight: var(--weight-semibold);
  }

  .ts-demo__status--error {
    color: var(--color-secondary);
    font-weight: var(--weight-semibold);
  }

  .ts-demo__status--pending {
    color: var(--color-text-subtle);
    font-style: italic;
  }

  .ts-demo__code {
    background: var(--color-background);
    color: var(--color-foreground);
    border-radius: var(--radius-md);
    padding: 0.75rem;
    font-size: var(--text-xs);
    font-family: ui-monospace, monospace;
    text-align: left;
    width: 100%;
    overflow-x: auto;
    line-height: 1.5;
  }

  .ts-demo__spinner {
    display: inline-block;
    width: 0.85rem;
    height: 0.85rem;
    border: 2px solid color-mix(in srgb, var(--color-primary) 20%, transparent);
    border-top-color: var(--color-primary);
    border-radius: 50%;
    animation: ts-spin 0.6s linear infinite;
    vertical-align: middle;
  }

  @keyframes ts-spin {
    to { transform: rotate(360deg); }
  }

  @media (prefers-reduced-motion: reduce) {
    .ts-demo__toggle,
    .ts-demo__knob {
      transition: none;
    }
    .ts-demo__toggle--loading .ts-demo__knob {
      animation: none;
    }
    .ts-demo__spinner {
      animation: none;
    }
  }
</style>

<script>
  const SIMULATED_DELAY = 1200;

  function setupToggleDemo(prefix) {
    const pessToggle = document.getElementById(`${prefix}-pess-toggle`);
    const pessStatus = document.getElementById(`${prefix}-pess-status`);
    const optToggle = document.getElementById(`${prefix}-opt-toggle`);
    const optStatus = document.getElementById(`${prefix}-opt-status`);

    function pessToggleHandler() {
      if (pessToggle.dataset.loading === "true") return;

      const turningOn = pessToggle.getAttribute("aria-checked") !== "true";
      pessToggle.dataset.loading = "true";
      pessToggle.classList.add("ts-demo__toggle--loading");
      pessStatus.className = "ts-demo__status ts-demo__status--pending";
      pessStatus.innerHTML = '<span class="ts-demo__spinner"></span> Saving&hellip;';

      setTimeout(() => {
        pessToggle.setAttribute("aria-checked", turningOn ? "true" : "false");
        pessToggle.dataset.loading = "false";
        pessToggle.classList.remove("ts-demo__toggle--loading");
        pessStatus.className = "ts-demo__status ts-demo__status--success";
        pessStatus.textContent = turningOn ? "Notifications on!" : "Notifications off";
      }, SIMULATED_DELAY);
    }

    function optToggleHandler() {
      if (optToggle.dataset.loading === "true") return;

      const turningOn = optToggle.getAttribute("aria-checked") !== "true";
      optToggle.setAttribute("aria-checked", turningOn ? "true" : "false");
      optToggle.dataset.loading = "true";
      optStatus.className = "ts-demo__status ts-demo__status--pending";
      optStatus.textContent = turningOn ? "Turning on…" : "Turning off…";

      setTimeout(() => {
        optToggle.dataset.loading = "false";
        optStatus.className = "ts-demo__status ts-demo__status--success";
        optStatus.textContent = turningOn ? "Notifications on!" : "Notifications off";
      }, SIMULATED_DELAY);
    }

    pessToggle.onclick = pessToggleHandler;
    optToggle.onclick = optToggleHandler;
  }

  setupToggleDemo("ts");
</script>
