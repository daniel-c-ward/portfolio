---
export interface AccordionItem {
  id: string;
  title: string;
  content: string;
}

interface Props {
  items: AccordionItem[];
}

const { items } = Astro.props;
---

<div class="accordion" data-accordion>
  {
    items.map((item) => (
      <div class="accordion__item">
        <h3 class="accordion__heading">
          <button
            type="button"
            class="accordion__trigger"
            id={`accordion-trigger-${item.id}`}
            aria-expanded="false"
            aria-controls={`accordion-panel-${item.id}`}
            data-accordion-trigger
          >
            <span>{item.title}</span>
            <span class="accordion__icon" aria-hidden="true" />
          </button>
        </h3>
        <div
          id={`accordion-panel-${item.id}`}
          class="accordion__panel"
          role="region"
          aria-labelledby={`accordion-trigger-${item.id}`}
          hidden
          data-accordion-panel
        >
          <div class="accordion__content" set:html={item.content} />
        </div>
      </div>
    ))
  }
</div>

<style>
  .accordion {
    display: flex;
    flex-direction: column;
    gap: var(--space-gap-md);
    margin-top: var(--space-gap-xl);
    max-width: 40rem;
  }

  .accordion__item {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: color-mix(
      in srgb,
      var(--color-surface) 72%,
      var(--color-background)
    );
    overflow: hidden;
  }

  .accordion__heading {
    margin: 0;
    font-size: inherit;
  }

  .accordion__trigger {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-gap-md);
    padding: 0.9rem 1rem;
    border: 0;
    background: transparent;
    color: var(--color-foreground);
    font: inherit;
    font-weight: var(--weight-semibold);
    text-align: left;
    cursor: pointer;
  }

  .accordion__trigger:hover {
    color: var(--color-primary);
  }

  .accordion__trigger:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: -2px;
  }

  .accordion__icon {
    flex-shrink: 0;
    width: 0.65rem;
    height: 0.65rem;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: rotate(45deg);
    transition: transform var(--transition-base);
  }

  .accordion__trigger[aria-expanded="true"] .accordion__icon {
    transform: rotate(-135deg);
  }

  .accordion__panel {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows var(--transition-slow);
  }

  .accordion__panel.is-open {
    grid-template-rows: 1fr;
  }

  .accordion__content {
    overflow: hidden;
    padding: 0 1rem;
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: color-mix(in srgb, var(--color-foreground) 76%, transparent);
  }

  .accordion__panel.is-open .accordion__content {
    padding-bottom: 1rem;
  }

  .accordion__content :global(p) {
    margin: 0 0 var(--space-gap-md);
  }

  .accordion__content :global(p:last-child) {
    margin-bottom: 0;
  }

  .accordion__content :global(ul) {
    margin: 0 0 var(--space-gap-md);
    padding-left: 1.1rem;
  }

  .accordion__content :global(li + li) {
    margin-top: var(--space-gap-sm);
  }

  @media (prefers-reduced-motion: reduce) {
    .accordion__panel,
    .accordion__icon {
      transition: none;
    }
  }
</style>

<script>
  function initAccordions() {
    document.querySelectorAll("[data-accordion]").forEach((root) => {
      const triggers = Array.from(
        root.querySelectorAll<HTMLButtonElement>("[data-accordion-trigger]"),
      );

      const closePanel = (trigger: HTMLButtonElement) => {
        const panelId = trigger.getAttribute("aria-controls");
        if (!panelId) return;

        const panel = document.getElementById(panelId);
        if (!panel) return;

        trigger.setAttribute("aria-expanded", "false");
        panel.classList.remove("is-open");

        const hidePanel = () => {
          if (panel.classList.contains("is-open")) return;
          panel.setAttribute("hidden", "");
        };

        panel.addEventListener("transitionend", hidePanel, { once: true });
        window.setTimeout(hidePanel, 400);
      };

      const openPanel = (trigger: HTMLButtonElement) => {
        const panelId = trigger.getAttribute("aria-controls");
        if (!panelId) return;

        const panel = document.getElementById(panelId);
        if (!panel) return;

        if (window.umami) {
          window.umami.track("Accordion Open", {
            section: trigger.querySelector("span")?.textContent?.trim(),
          });
        }

        triggers.forEach((other) => {
          if (other !== trigger) closePanel(other);
        });

        trigger.setAttribute("aria-expanded", "true");
        panel.removeAttribute("hidden");
        panel.classList.add("is-open");
      };

      triggers.forEach((trigger) => {
        trigger.addEventListener("click", () => {
          const isOpen = trigger.getAttribute("aria-expanded") === "true";
          if (isOpen) closePanel(trigger);
          else openPanel(trigger);
        });

        trigger.addEventListener("keydown", (event) => {
          const index = triggers.indexOf(trigger);
          if (index < 0) return;

          if (event.key === "ArrowDown") {
            event.preventDefault();
            triggers[index + 1]?.focus();
          } else if (event.key === "ArrowUp") {
            event.preventDefault();
            triggers[index - 1]?.focus();
          } else if (event.key === "Home") {
            event.preventDefault();
            triggers[0]?.focus();
          } else if (event.key === "End") {
            event.preventDefault();
            triggers[triggers.length - 1]?.focus();
          }
        });
      });
    });
  }

  initAccordions();
  document.addEventListener("astro:page-load", initAccordions);
</script>
