---
import type { MdEntry } from "../lib/md-entries";

interface Props {
  item: MdEntry;
  basePath: string;
  isCompact?: boolean;
  index?: number;
  inCarousel?: boolean;
  actionLabel?: string;
  showActions?: boolean;
  disableMediaLink?: boolean;
  href?: string;
}

const { item, basePath, index = 0 } = Astro.props;
const isCompact = Astro.props.isCompact ?? item.isCompact ?? false;
const inCarousel = Astro.props.inCarousel ?? isCompact;
const actionLabel = Astro.props.actionLabel ?? "Case Study";
const showActions = Astro.props.showActions ?? true;
const disableMediaLink = Astro.props.disableMediaLink ?? false;
const isThemed =
  !isCompact && Boolean(item.colourLight) && Boolean(item.colourDark);
const showCompactLogo = isCompact && item.isLogo && item.logoImage;
const showDetailLogo = !isCompact && item.isLogo && item.logoImage;
const image = showCompactLogo ? item.logoImage : item.featuredImage;
const articleClass = [
  "content-card",
  inCarousel ? "carousel__slide" : "",
  isCompact ? "content-card--compact" : "content-card--detail",
  isThemed ? "content-card--themed" : "",
  !isCompact && index % 2 === 1 ? "content-card--media-right" : "",
]
  .filter(Boolean)
  .join(" ");
const themedStyle = isThemed
  ? `--project-colour-light: ${item.colourLight}; --project-colour-dark: ${item.colourDark};`
  : undefined;
const href = Astro.props.href ?? `${basePath}/${item.slug}`;
const demoUrl = item.url?.startsWith("http")
  ? item.url
  : item.url
    ? `https://${item.url}`
    : undefined;
const formattedDate =
  item.date &&
  new Date(item.date).toLocaleDateString("en-GB", {
    year: "numeric",
    month: "short",
    day: "numeric",
  });
---

<article
  class={articleClass}
  style={themedStyle}
  data-carousel-slide={inCarousel ? true : undefined}
>
  {
    isCompact ? (
      disableMediaLink ? (
        <figure class="content-card__media" aria-label={item.title}>
          <img
            class={`content-card__image${showCompactLogo ? " content-card__image--logo" : ""}`}
            src={image}
            alt=""
            width="auto"
            height="auto"
            loading="eager"
            decoding="async"
            draggable="false"
          />
        </figure>
      ) : (
        <a
          class="content-card__media"
          href={href}
          draggable="false"
          aria-label={item.title}
        >
          <img
            class={`content-card__image${showCompactLogo ? " content-card__image--logo" : ""}`}
            src={image}
            alt=""
            width="480"
            height="270"
            loading="lazy"
            decoding="async"
            draggable="false"
          />
        </a>
      )
    ) : item.hasLiveDemo && demoUrl ? (
      <figure class="content-card__media content-card__media--iframe" aria-label={`${item.title} live preview`}>
        <iframe
          class="content-card__iframe"
          src={demoUrl}
          title={`${item.title} live preview`}
          loading="lazy"
          sandbox="allow-scripts allow-same-origin"
        />
      </figure>
    ) : null
  }

  <section class="content-card__body" aria-labelledby={`project-${item.slug}`}>
    <header class="content-card__header">
      {
        showDetailLogo && (
          <img
            class="content-card__logo"
            src={item.logoImage}
            alt=""
            width="160"
            height="80"
            loading="lazy"
            decoding="async"
          />
        )
      }
      <h3 id={`project-${item.slug}`}>{item.title}</h3>
      {
        !isCompact && formattedDate && (
          <p class="content-card__date">{formattedDate}</p>
        )
      }
    </header>

    {
      item.tags.length > 0 && (
        <footer class="content-card__tags" aria-label="Tags">
          {item.tags.map((tag) => (
            <span class="content-card__tag">{tag}</span>
          ))}
        </footer>
      )
    }
    {item.description && <p>{item.description}</p>}

    {
      !isCompact && (
        <dl class="content-card__meta">
          {item.challenge && (
            <>
              <dt>Challenge</dt>
              <dd>{item.challenge}</dd>
            </>
          )}
          {item.solution && (
            <>
              <dt>Solution</dt>
              <dd>{item.solution}</dd>
            </>
          )}
          {item.impact && (
            <>
              <dt>Impact</dt>
              <dd>{item.impact}</dd>
            </>
          )}
          {item.labCategory && (
            <>
              <dt>Lab Category</dt>
              <dd>{item.labCategory}</dd>
            </>
          )}
          {item.difficulty && (
            <>
              <dt>Difficulty</dt>
              <dd>{item.difficulty}</dd>
            </>
          )}
          {item.inspiration && (
            <>
              <dt>Inspiration</dt>
              <dd>{item.inspiration}</dd>
            </>
          )}
        </dl>
      )
    }

    {
      !isCompact && item.tools.length > 0 && (
        <footer class="content-card__tags" aria-label="Tech Stack">
          {item.tools.map((tool) => (
            <span class="content-card__tag">{tool}</span>
          ))}
        </footer>
      )
    }

    {
      showActions && (
        <footer class="content-card__actions">
          {!isCompact && item.hasLiveDemo && demoUrl && (
            <a
              class="button button--secondary"
              href={demoUrl}
              target="_blank"
              rel="noreferrer"
            >
              View Site
            </a>
          )}
          <a class="button button--primary" href={href} draggable="false">
            {actionLabel}
          </a>
        </footer>
      )
    }
  </section>
</article>
