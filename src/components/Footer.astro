---
// Import all markdown modules for Lab and Work
const labModules = import.meta.glob('../content/lab/**/*.md', { eager: true });
const workModules = import.meta.glob('../content/work/**/*.md', { eager: true });

// Helper to safely extract metadata
function extractPosts(modules) {
  return Object.entries(modules)
    .map(([path, mod]) => {
      const meta = (mod as any).metadata || {};
      return {
        title: meta.title || 'Untitled',
        url: '/' + path.replace(/^..\/..\/content\//, '').replace(/\.md$/, ''),
        date: new Date(meta.date || 0)
      };
    })
    .sort((a, b) => b.date - a.date)
    .slice(0, 5);
}

const labPosts = extractPosts(labModules);
const workPosts = extractPosts(workModules);
---
<footer class="footer">
  <div class="footer__container">
    <!-- Column: Home -->
    <div class="footer__column">
      <h4 class="footer__info-title">Home</h4>
      <ul class="footer__list">
        <li><a href="/" class="footer__info-link">Home</a></li>
      </ul>
    </div>
    <!-- Column: Lab -->
    <div class="footer__column">
      <h4 class="footer__info-title">Lab</h4>
      <ul class="footer__list">
        {labPosts.length === 0 ? (
          <li class="footer__info-link">No recent labs</li>
        ) : (
          labPosts.map(post => (
            <li><a href={post.url} class="footer__info-link">{post.title}</a></li>
          ))
        )}
      </ul>
    </div>
    <!-- Column: Work -->
    <div class="footer__column">
      <h4 class="footer__info-title">Work</h4>
      <ul class="footer__list">
        {workPosts.length === 0 ? (
          <li class="footer__info-link">No recent work</li>
        ) : (
          workPosts.map(post => (
            <li><a href={post.url} class="footer__info-link">{post.title}</a></li>
          ))
        )}
      </ul>
    </div>
    <!-- Column: Contact -->
    <div class="footer__column">
      <h4 class="footer__info-title">Contact</h4>
      <ul class="footer__list">
        <li><a href="/contact" class="footer__info-link">Contact</a></li>
      </ul>
    </div>
    <!-- Column: LinkedIn -->
    <div class="footer__column">
      <h4 class="footer__info-title">LinkedIn</h4>
      <a href="https://linkedin.com/in/daniel-ward" target="_blank" rel="noopener" class="footer__social-link" aria-label="LinkedIn">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
          <path d="M4.98 3C3.34 3 2 4.34 2 5.98c0 1.62 1.34 2.97 2.98 2.97h.02C6.66 8.95 8 7.6 8 5.98 8 4.34 6.66 3 5.02 3H4.98zM2 9h6v12H2V9zm7.5 0h5.2v1.71h.07c.73-1.38 2.52-2.84 5.19-2.84 5.55 0 6.58 3.66 6.58 8.42V21h-6v-7.01c0-1.68-.03-3.84-2.34-3.84-2.34 0-2.7 1.83-2.7 3.72V21h-6V9z"/>
        </svg>
      </a>
    </div>
  </div>
</footer>
  <div class="footer__container">
    <!-- Brand -->
    <div class="footer__brand">
      <span class="footer__logo">DW</span>
    </div>
    <!-- Home column -->
    <div class="footer__column">
      <a href="/" class="footer__link">Home</a>
    </div>
    <!-- Lab column -->
    <div class="footer__column">
      <h4 class="footer__title">Lab</h4>
      <ul class="footer__list">
        {labPosts.map(post => (
          <li><a href={post.url} class="footer__info-link">{post.title}</a></li>
        ))}
      </ul>
    </div>
    <!-- Work column -->
    <div class="footer__column">
      <h4 class="footer__title">Work</h4>
      <ul class="footer__list">
        {workPosts.map(post => (
          <li><a href={post.url} class="footer__info-link">{post.title}</a></li>
        ))}
      </ul>
    </div>
    <!-- Contact column -->
    <div class="footer__column">
      <a href="/contact" class="footer__link">Contact</a>
    </div>
    <!-- LinkedIn column -->
    <div class="footer__column">
      <a href="https://linkedin.com/in/daniel-ward" target="_blank" rel="noopener" class="footer__social-link" aria-label="LinkedIn">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
          <path d="M4.98 3C3.34 3 2 4.34 2 5.98c0 1.62 1.34 2.97 2.98 2.97h.02C6.66 8.95 8 7.6 8 5.98 8 4.34 6.66 3 5.02 3H4.98zM2 9h6v12H2V9zm7.5 0h5.2v1.71h.07c.73-1.38 2.52-2.84 5.19-2.84 5.55 0 6.58 3.66 6.58 8.42V21h-6v-7.01c0-1.68-.03-3.84-2.34-3.84-2.34 0-2.7 1.83-2.7 3.72V21h-6V9z"/>
        </svg>
      </a>
    </div>
  </div>
</footer>
<style>
  .footer {
    padding: 3rem 0;
    background: color-mix(in srgb, var(--color-surface) 92%, transparent);
    backdrop-filter: blur(8px);
    color: var(--color-foreground);
  }
  .footer__container {
    max-width: 1100px;
    margin: 0 auto;
    display: grid;
    gap: 2rem;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    align-items: start;
  }
  .footer__brand {font-family: var(--font-lexend);font-size: 2rem;font-weight: 800;color: var(--color-primary);}
  .footer__logo {font-weight: 900;}
  .footer__column {display: flex;flex-direction: column;gap: 0.5rem;}
  .footer__link, .footer__info-link {color: var(--color-foreground);text-decoration: none;transition: color 0.2s;}
  .footer__link:hover, .footer__info-link:hover {color: var(--color-primary);}
  .footer__title {margin: 0;font-size: 1.1rem;color: var(--color-primary);}
  .footer__list {list-style: none;margin: 0;padding: 0;}
  .footer__social-link {color: var(--color-foreground);transition: color 0.2s, transform 0.2s;}
  .footer__social-link:hover {color: var(--color-primary);transform: translateY(-2px);}
  @media (prefers-color-scheme: dark) { .footer {background: rgba(30,30,30,0.85);} }
</style>