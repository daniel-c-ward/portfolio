---
import type { CvEntry } from "../lib/cv-entries";
import { parseCaseStudy } from "../lib/cv-entries";

interface Props {
  entries: CvEntry[];
}

const { entries } = Astro.props;
---

<ol class="timeline" aria-label="Experience and education">
  {
    entries.map((entry, index) => {
      const side = index % 2 === 0 ? "left" : "right";

      return (
        <li
          class:list={["timeline__item", `timeline__item--${side}`]}
          data-kind={entry.kind}
        >
          <div class="timeline__marker" aria-hidden="true">
            <span class="timeline__node" />
          </div>
          <article class="timeline__card content-card">
            <div class="timeline__card-body content-card__body">
              <p class="timeline__date content-card__date">{entry.year}</p>
              <h3 class="timeline__title">{entry.position}</h3>
              <p class="timeline__org">{entry.title}</p>
              {entry.description && (
                <p class="timeline__description">{entry.description}</p>
              )}
              {entry.casestudies && entry.casestudies.length > 0 && (
                <div class="timeline__links">
                  <p class="timeline__links-label">Related work</p>
                  <div class="timeline__links-list">
                    {entry.casestudies.map((casestudy) => {
                      const parsed = parseCaseStudy(casestudy);

                      return parsed.href ? (
                        <a class="timeline__link" href={parsed.href}>
                          {parsed.text}
                        </a>
                      ) : (
                        <span class="timeline__link">{parsed.text}</span>
                      );
                    })}
                  </div>
                </div>
              )}
            </div>
          </article>
        </li>
      );
    })
  }
</ol>

<style>
  .timeline {
    position: relative;
    list-style: none;
    margin: 0;
    padding: var(--space-gap-md) 0 var(--space-section-y-top);
  }

  .timeline::before {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 2px;
    transform: translateX(-50%);
    background: color-mix(in srgb, var(--color-primary) 28%, var(--color-border));
  }

  .timeline__item {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    gap: var(--space-gap-lg);
    align-items: start;
    margin-bottom: var(--space-gap-2xl);
  }

  .timeline__item:last-child {
    margin-bottom: 0;
  }

  .timeline__marker {
    grid-column: 2;
    grid-row: 1;
    display: flex;
    justify-content: center;
    padding-top: 1.35rem;
  }

  .timeline__node {
    width: 0.85rem;
    height: 0.85rem;
    border-radius: 50%;
    background: var(--color-background);
    border: 2px solid var(--color-primary);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-primary) 16%, transparent);
  }

  .timeline__item[data-kind="education"] .timeline__node {
    border-color: var(--color-secondary);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-secondary) 16%, transparent);
  }

  .timeline__card {
    grid-row: 1;
    min-width: 0;
  }

  .timeline__item--left .timeline__card {
    grid-column: 1;
    text-align: right;
  }

  .timeline__item--right .timeline__card {
    grid-column: 3;
  }

  .timeline__card-body {
    gap: var(--space-gap-sm);
  }

  .timeline__title {
    margin: 0;
    font-size: var(--text-h3);
    line-height: var(--leading-tight);
  }

  .timeline__org {
    margin: 0;
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    color: var(--color-primary);
  }

  .timeline__date {
    margin: 0;
  }

  .timeline__description {
    margin: 0;
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: color-mix(in srgb, var(--color-foreground) 72%, transparent);
  }

  .timeline__links {
    display: flex;
    flex-direction: column;
    gap: var(--space-gap-sm);
    margin-top: var(--space-gap-sm);
  }

  .timeline__links-label {
    margin: 0;
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--color-foreground) 55%, transparent);
  }

  .timeline__links-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-gap-sm);
  }

  .timeline__item--left .timeline__links-list {
    justify-content: flex-end;
  }

  .timeline__link {
    display: inline-block;
    padding: 0.28rem 0.55rem;
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    color: var(--color-primary);
    text-decoration: none;
    background: color-mix(in srgb, var(--color-primary) 14%, var(--color-surface));
    border: 1px solid color-mix(in srgb, var(--color-primary) 30%, transparent);
    border-radius: var(--radius-pill);
  }

  .timeline__link:hover {
    border-color: var(--color-primary);
  }

  @media (max-width: 767px) {
    .timeline {
      --timeline-track: 2.25rem;
      padding-right: calc(var(--timeline-track) + var(--space-gap-md));
    }

    .timeline::before {
      left: calc(var(--timeline-track) / 2);
      transform: translateX(-50%);
    }

    .timeline__item,
    .timeline__item--left,
    .timeline__item--right {
      grid-template-columns: var(--timeline-track) minmax(0, 1fr);
      gap: var(--space-gap-md);
    }

    .timeline__marker {
      grid-column: 1;
      justify-content: center;
      width: 100%;
      padding-top: 1.1rem;
    }

    .timeline__card,
    .timeline__item--left .timeline__card,
    .timeline__item--right .timeline__card {
      grid-column: 2;
      text-align: left;
    }

    .timeline__item--left .timeline__links-list {
      justify-content: flex-start;
    }
  }
</style>
