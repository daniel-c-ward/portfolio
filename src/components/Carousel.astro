---
import type { MdEntry } from "../lib/md-entries";
import ProjectCard from "./ProjectCard.astro";

interface Props {
  items: MdEntry[];
  basePath: string;
  id: string;
  label: string;
  isCompact?: boolean;
  actionLabel?: string;
}

const { items, basePath, id, label, isCompact, actionLabel } = Astro.props;
---

{
  items.length > 0 && (
    <div class="carousel" data-carousel>
      <div
        id={id}
        class="carousel__track"
        data-carousel-track
        role="region"
        aria-roledescription="carousel"
        aria-label={label}
        tabindex="0"
      >
        {items.map((item, index) => (
          <ProjectCard
            item={item}
            basePath={basePath}
            isCompact={isCompact}
            index={index}
            inCarousel={true}
            actionLabel={actionLabel}
          />
        ))}
      </div>
    </div>
  )
}
