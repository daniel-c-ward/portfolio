---
import type { MdEntry } from "../lib/md-entries";

interface Props {
  items: MdEntry[];
  basePath: string;
  id: string;
  label: string;
}

const { items, basePath, id, label } = Astro.props;
---

{
  items.length > 0 && (
    <div class="carousel" data-carousel>
      <div
        id={id}
        class="carousel__track"
        data-carousel-track
        role="region"
        aria-roledescription="carousel"
        aria-label={label}
        tabindex="0"
      >
        {items.map((item) => (
          <div class="content-card carousel__slide" data-carousel-slide>
            <img
              class={`content-card__image${item.logo ? " content-card__image--logo" : ""}`}
              src={item.img}
              alt=""
              width="480"
              height="270"
              loading="lazy"
              decoding="async"
              draggable="false"
            />
            <div class="content-card__body">
              <h3>{item.title}</h3>
              {item.date && (
                <p class="content-card__date">
                  {new Date(item.date).toLocaleDateString("en-UK", {
                    year: "numeric",
                    month: "short",
                    day: "numeric",
                  })}
                </p>
              )}
              {item.description && <p>{item.description}</p>}
              {item.tags.length > 0 && (
                <div class="content-card__tags" aria-label="Tags">
                  {item.tags.map((tag) => (
                    <span class="content-card__label">{tag}</span>
                  ))}
                </div>
              )}
            </div>
            <div class="content-card__actions">
              {item.url && (
                <a
                  class="button button--secondary button--small"
                  href={
                    item.url.startsWith("http")
                      ? item.url
                      : `https://${item.url}`
                  }
                  target="_blank"
                  rel="noopener noreferrer"
                  draggable="false"
                >
                  Visit Site
                  <svg
                    width="12"
                    height="12"
                    viewBox="0 0 16 16"
                    fill="none"
                    aria-hidden="true"
                    style="margin-left:0.3rem;"
                  >
                    <path
                      d="M5 3h8v8M13 3L3 13"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </a>
              )}
              <a
                class="button button--primary button--small"
                href={`${basePath}/${item.slug}`}
                draggable="false"
              >
                Case Study
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  )
}

<script>
  import "../scripts/carousel.ts";
</script>

<style>
  .carousel {
    position: relative;
    margin-top: 1.25rem;
  }

  .carousel::before,
  .carousel::after {
    position: absolute;
    top: 0;
    bottom: 0.75rem;
    z-index: 1;
    width: clamp(1.25rem, 4vw, 3rem);
    content: "";
    pointer-events: none;
    opacity: 0.88;
    transition: opacity 0.2s ease;
  }

  .carousel__track {
    display: flex;
    gap: clamp(0.85rem, 2vw, 1.15rem);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: 0.5rem;
    padding: 0.15rem 0.5rem 0.75rem;
    margin-inline: -0.5rem;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    touch-action: pan-x pan-y pinch-zoom;
    transition: scroll-padding 0.2s ease;
  }

  .carousel__track::-webkit-scrollbar {
    display: none;
  }

  .carousel__track.is-dragging {
    scroll-snap-type: none;
    user-select: none;
  }

  .carousel:focus-within::before,
  .carousel:focus-within::after,
  .carousel:hover::before,
  .carousel:hover::after {
    opacity: 1;
  }

  .carousel__track:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 4px;
    border-radius: 0.25rem;
  }

  .carousel__slide {
    width: clamp(18.75rem, 52vw, 37.5rem);
    min-width: 18.75rem;
    max-width: 37.5rem;
    flex: 0 0 auto;
    scroll-snap-align: start;
    scroll-snap-stop: always;
    padding: 0;
    overflow: hidden;
    -webkit-user-drag: none;
  }

  .content-card__actions {
    display: flex;
    gap: 0.5rem;
    padding: 0 0.85rem 0.85rem;
    margin-top: auto;
  }

  .content-card__actions .button {
    flex: 1;
  }

  @media (max-width: 520px) {
    .carousel__slide {
      width: min(88vw, 37.5rem);
      min-width: 18.75rem;
      max-width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .carousel__track {
      scroll-behavior: auto;
    }
  }
</style>
