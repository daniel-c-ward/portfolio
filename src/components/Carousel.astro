---
import type { MdEntry } from "../lib/md-entries";
import ProjectCard from "./ProjectCard.astro";

interface Props {
  items: MdEntry[];
  basePath: string;
  id: string;
  label: string;
  isCompact?: boolean;
  actionLabel?: string;
  getHref?: (item: MdEntry) => string;
}

const { items, basePath, id, label, isCompact, actionLabel, getHref } =
  Astro.props;
---

{
  items.length > 0 && (
    <div class="carousel" data-carousel>
      {items.length > 1 && (
        <button
          class="carousel__control carousel__control--previous"
          type="button"
          data-carousel-control="previous"
          aria-controls={id}
          aria-label={`Previous ${label.toLowerCase()} card`}
        >
          <svg
            aria-hidden="true"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.25"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="m15 18-6-6 6-6"></path>
          </svg>
        </button>
      )}
      <div
        id={id}
        class="carousel__track"
        data-carousel-track
        role="region"
        aria-roledescription="carousel"
        aria-label={label}
        tabindex="0"
      >
        {items.map((item, index) => (
          <ProjectCard
            item={item}
            basePath={basePath}
            isCompact={isCompact}
            index={index}
            inCarousel={true}
            actionLabel={actionLabel}
            href={getHref?.(item)}
          />
        ))}
      </div>
      {items.length > 1 && (
        <button
          class="carousel__control carousel__control--next"
          type="button"
          data-carousel-control="next"
          aria-controls={id}
          aria-label={`Next ${label.toLowerCase()} card`}
        >
          <svg
            aria-hidden="true"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.25"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="m9 18 6-6-6-6"></path>
          </svg>
        </button>
      )}
    </div>
  )
}


<script>
  const carousels = document.querySelectorAll("[data-carousel]");
  const prefersReducedMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  );

  carousels.forEach((carousel) => {
    const track = carousel.querySelector("[data-carousel-track]");
    const slides = [...carousel.querySelectorAll("[data-carousel-slide]")];
    const previousButton = carousel.querySelector(
      '[data-carousel-control="previous"]',
    );
    const nextButton = carousel.querySelector('[data-carousel-control="next"]');

    if (!track || slides.length < 2 || !previousButton || !nextButton) {
      return;
    }

    const slidePositions = () =>
      slides.map((slide) => slide.offsetLeft - track.offsetLeft);

    const currentIndex = () => {
      const positions = slidePositions();

      return positions.reduce(
        (closest, position, index) => {
          const distance = Math.abs(track.scrollLeft - position);
          return distance < closest.distance ? { distance, index } : closest;
        },
        { distance: Number.POSITIVE_INFINITY, index: 0 },
      ).index;
    };

    const scrollToSlide = (index) => {
      const targetIndex = Math.max(0, Math.min(slides.length - 1, index));
      const positions = slidePositions();

      track.scrollTo({
        left: positions[targetIndex],
        behavior: prefersReducedMotion.matches ? "auto" : "smooth",
      });
    };

    const updateControls = () => {
      const index = currentIndex();

      previousButton.disabled = index === 0;
      nextButton.disabled = index === slides.length - 1;
    };

    const handleControlClick = (event) => {
      const direction = event.currentTarget.dataset.carouselControl;
      const offset = direction === "next" ? 1 : -1;

      if (window.umami) {
        window.umami.track("Carousel Click", {
          carousel: carousel.id,
          direction,
        });
      }

      scrollToSlide(currentIndex() + offset);
    };

    previousButton.addEventListener("click", handleControlClick);
    nextButton.addEventListener("click", handleControlClick);

    let frame = 0;
    track.addEventListener(
      "scroll",
      () => {
        cancelAnimationFrame(frame);
        frame = requestAnimationFrame(updateControls);
      },
      { passive: true },
    );

    window.addEventListener("resize", updateControls);
    updateControls();
  });
</script>
