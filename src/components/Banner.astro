---
import "../styles/global.css";
import ThemeToggle from "./ThemeToggle.astro";
---

<header class="header">
  <p class="banner__wordmark"><a class="wordmark" href="/">Daniel Ward</a></p>
  <div class="nav-wrapper">
    <nav class="banner__nav" aria-label="Primary navigation">
      <a class="nav-link" href="/">Home</a>
      <a class="nav-link" href="/cv">CV</a>
      <a class="nav-link" href="/work">Work</a>
      <a class="nav-link" href="/lab">Lab</a>
    </nav>
    <a class="button button--primary cta-contact" href="/contact">Contact</a>
    <ThemeToggle />
    <button
      class="menu"
      type="button"
      aria-label="Open navigation"
      aria-expanded="false"
      aria-controls="drawer-nav"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>

  <nav id="drawer-nav" class="drawer-nav" aria-label="Mobile navigation" hidden>
    <a class="nav-link" href="/">Home</a>
    <a class="nav-link" href="/cv">CV</a>
    <a class="nav-link" href="/work">Work</a>
    <a class="nav-link" href="/lab">Lab</a>
    <a class="button button--primary cta-contact" href="/contact">Contact</a>
  </nav>
</header>

<style>
  /* ============================================================
   NAVIGATION
   ============================================================ */

  /* Nav link */
  .nav-link {
    color: var(--color-primary);
    text-decoration: none;
    transition:
      color var(--transition-fast),
      transform var(--transition-fast);
    will-change: transform;
  }
  .nav-link:hover,
  .nav-link:focus-visible {
    color: color-mix(in srgb, var(--color-primary) 88%, #000);
    text-decoration: none;
    transform: translateY(-0.2rem);
  }

  /* Burger menu */
  .menu {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
  }

  @media (max-width: 700px) {
    .menu {
      display: flex;
      flex-direction: column;
      gap: 4px;
      width: 28px;
      height: 28px;
      justify-content: center;
    }
    .menu span {
      display: block;
      width: 100%;
      height: 2px;
      background: var(--color-primary);
      transition:
        transform var(--transition-base),
        opacity var(--transition-base);
    }
    .menu[aria-expanded="true"] span:nth-child(1) {
      transform: rotate(45deg) translate(0.5px, 8px);
    }
    .menu[aria-expanded="true"] span:nth-child(2) {
      opacity: 0;
    }
    .menu[aria-expanded="true"] span:nth-child(3) {
      transform: rotate(-45deg) translate(0.5px, -8px);
    }

    /* Hide desktop nav links and CTA */
    .nav-wrapper .banner__nav {
      display: none !important;
    }
    .nav-wrapper .banner__nav a {
      display: none !important;
    }
    .nav-wrapper .cta-contact {
      display: none !important;
    }

    .nav-wrapper {
      gap: 0.5rem;
    }

    /* Drawer navigation */
    .drawer-nav {
      position: fixed;
      top: var(--header-height);
      right: 0;
      left: auto;
      height: calc(100vh - var(--header-height));
      width: 85%;
      max-width: 320px;
      background: var(--color-surface);
      border-left: 1px solid var(--color-border);
      box-shadow: -8px 0 24px
        color-mix(in srgb, var(--color-primary) 12%, transparent);
      transform: translateX(100%);
      transition:
        transform 0.22s ease,
        opacity 0.22s ease;
      opacity: 0;
      z-index: 9998;
      display: flex;
      flex-direction: column;
      padding: var(--space-gap-lg);
      gap: var(--space-gap-md);
      overflow-y: auto;
      pointer-events: auto;
    }
    .drawer-nav.open {
      transform: translateX(0);
      opacity: 1;
    }

    .drawer-nav .nav-link,
    .drawer-nav .button {
      display: block;
    }
  }
</style>

<script>
  (function () {
    const menu = document.querySelector(".menu");
    const drawer = document.querySelector(".drawer-nav");
    const BREAKPOINT = 700;

    function closeDrawer() {
      if (!drawer) return;
      drawer.classList.remove("open");
      drawer.setAttribute("hidden", "");
      if (menu) {
        menu.setAttribute("aria-expanded", "false");
        menu.setAttribute("aria-label", "Open navigation");
      }
      document.body.style.overflow = "";
    }

    function openDrawer() {
      if (!drawer) return;
      drawer.classList.add("open");
      drawer.removeAttribute("hidden");
      if (menu) {
        menu.setAttribute("aria-expanded", "true");
        menu.setAttribute("aria-label", "Close navigation");
      }
      document.body.style.overflow = "hidden";
    }

    if (menu && drawer) {
      menu.addEventListener("click", () => {
        const isOpen = drawer.classList.contains("open");
        if (isOpen) closeDrawer();
        else openDrawer();
      });

      window.addEventListener("resize", () => {
        if (window.innerWidth > BREAKPOINT) closeDrawer();
      });

      document.addEventListener("click", (e) => {
        if (!drawer.classList.contains("open")) return;
        if (e.target.closest(".drawer-nav") || e.target.closest(".menu"))
          return;
        closeDrawer();
      });

      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") closeDrawer();
      });
    }
  })();
</script>
