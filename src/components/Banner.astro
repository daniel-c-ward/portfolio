---
import "../styles/global.css";
---

<header>
  <p class="wordmark"><a href="/">Daniel Ward</a></p>
  <nav class="desktop-nav" aria-label="Primary navigation">
    <a href="/">Home</a>
    <a href="/work">Work</a>
    <a href="/lab">Lab</a>
    <a class="button button--primary button--small" href="/contact">Contact</a>
  </nav>
  <button
    class="menu"
    type="button"
    aria-label="Open navigation"
    aria-expanded="false"
  >
    <span></span>
    <span></span>
    <span></span>
  </button>
  <nav class="menu-mobile" aria-label="Mobile navigation" hidden>
    <a href="/">Home</a>
    <a href="/work">Work</a>
    <a href="/lab">Lab</a>
    <a class="button button--primary button--small" href="/contact">Contact</a>
  </nav>
</header>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 50;
    box-sizing: border-box;
    height: 60px;
    background-color: color-mix(in srgb, var(--color-surface) 92%, transparent);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    padding: 0 1rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid
      color-mix(in srgb, var(--color-foreground) 10%, transparent);
  }

  .desktop-nav {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 0.5rem + 5vw, 2.5rem);
  }

  .desktop-nav a,
  .menu-mobile a {
    text-decoration: none;
    color: var(--color-foreground);
    font-family: var(--font-lexend);
    font-weight: 400;
    font-size: 0.95rem;
  }

  .desktop-nav a:hover,
  .menu-mobile a:hover {
    color: var(--color-primary);
  }

  .desktop-nav a.button,
  .desktop-nav a.button:hover,
  .menu-mobile a.button,
  .menu-mobile a.button:hover {
    color: var(--color-on-primary);
    font-weight: 700;
  }

  .wordmark {
    font-family: var(--font-lexend);
    font-weight: 700;
    font-size: 1.35rem;
    margin: 0;
  }

  .wordmark a {
    text-decoration: none;
    color: var(--color-foreground);
  }

  .menu {
    display: none;
    cursor: pointer;
    width: 2.75rem;
    aspect-ratio: 1;
    padding: 0.65rem;
    border: 0;
    background: transparent;
  }

  .menu span {
    display: block;
    width: 100%;
    height: 2px;
    background: var(--color-foreground);
    border-radius: 999px;
  }

  .menu-mobile {
    display: none;
    flex-direction: column;
    gap: 1rem;
    position: absolute;
    top: calc(100% + 0.5rem);
    right: 1rem;
    z-index: 20;
    background-color: var(--color-surface);
    padding: 1rem 1.25rem;
    border-radius: 0.5rem;
    border: 1px solid
      color-mix(in srgb, var(--color-foreground) 12%, transparent);
    box-shadow: 0 0.5rem 1.5rem rgba(0, 0, 0, 0.08);
    margin: 0;
    list-style: none;
  }

  .menu-mobile:not([hidden]) {
    display: flex;
  }

  @media (max-width: 700px) {
    .desktop-nav {
      display: none;
    }

    .menu {
      display: grid;
      align-content: center;
      gap: 0.3rem;
    }
  }
</style>

<script>
  const menu = document.querySelector(".menu");
  const nav = document.querySelector(".menu-mobile");

  if (menu && nav) {
    menu.addEventListener("click", () => {
      const isOpen = nav.hasAttribute("hidden");
      if (isOpen) {
        nav.removeAttribute("hidden");
        menu.setAttribute("aria-expanded", "true");
        menu.setAttribute("aria-label", "Close navigation");
      } else {
        nav.setAttribute("hidden", "");
        menu.setAttribute("aria-expanded", "false");
        menu.setAttribute("aria-label", "Open navigation");
      }
    });
  }
</script>
