---
import type { SkillIconName } from "../config/skills";

type Props = {
  name: SkillIconName;
};

const { name } = Astro.props;
---

<span class="skill-icon" aria-hidden="true">
  {
    name === "astro" && (
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 128 128">
        <>
          <defs>
            <>
              <linearGradient
                id="a"
                x1="882.997"
                x2="638.955"
                y1="27.113"
                y2="866.902"
                gradientTransform="scale(.1)"
                gradientUnits="userSpaceOnUse"
              >
                <>
                  <stop offset="0" stop-color="currentColor" />
                  <stop offset="1" stop-color="currentColor" />
                </>
              </linearGradient>
              <linearGradient
                id="b"
                x1="1001.68"
                x2="790.326"
                y1="652.45"
                y2="1094.91"
                gradientTransform="scale(.1)"
                gradientUnits="userSpaceOnUse"
              >
                <>
                  <stop offset="0" stop-color="currentColor" />
                  <stop offset="1" stop-color="currentColor" stop-opacity="0" />
                </>
              </linearGradient>
            </>
          </defs>
          <path
            fill="currentColor"
            d="M81.504 9.465c.973 1.207 1.469 2.836 2.457 6.09l21.656 71.136a90.079 90.079 0 0 0-25.89-8.765L65.629 30.28a1.833 1.833 0 0 0-3.52.004L48.18 77.902a90.104 90.104 0 0 0-26.003 8.778l21.758-71.14c.996-3.25 1.492-4.876 2.464-6.083a8.023 8.023 0 0 1 3.243-2.398c1.433-.575 3.136-.575 6.535-.575H71.72c3.402 0 5.105 0 6.543.579a7.988 7.988 0 0 1 3.242 2.402Zm0 0"
          />
          <path
            fill="currentColor"
            d="M84.094 90.074c-3.57 3.055-10.696 5.137-18.903 5.137-10.07 0-18.515-3.137-20.754-7.356-.8 2.418-.98 5.184-.98 6.954 0 0-.527 8.675 5.508 14.71a5.671 5.671 0 0 1 5.672-5.671c5.37 0 5.367 4.683 5.363 8.488v.336c0 5.773 3.527 10.719 8.543 12.805a11.62 11.62 0 0 1-1.172-5.098c0-5.508 3.23-7.555 6.988-9.938 2.989-1.894 6.309-4 8.594-8.222a15.513 15.513 0 0 0 1.875-7.41 15.55 15.55 0 0 0-.734-4.735Zm0 0"
          />
          <path
            fill="currentColor"
            d="M84.094 90.074c-3.57 3.055-10.696 5.137-18.903 5.137-10.07 0-18.515-3.137-20.754-7.356-.8 2.418-.98 5.184-.98 6.954 0 0-.527 8.675 5.508 14.71a5.671 5.671 0 0 1 5.672-5.671c5.37 0 5.367 4.683 5.363 8.488v.336c0 5.773 3.527 10.719 8.543 12.805a11.62 11.62 0 0 1-1.172-5.098c0-5.508 3.23-7.555 6.988-9.938 2.989-1.894 6.309-4 8.594-8.222a15.513 15.513 0 0 0 1.875-7.41 15.55 15.55 0 0 0-.734-4.735Zm0 0"
          />
        </>
      </svg>
    )
  }
  {
    name === "react" && (
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="currentColor"
      >
        <circle cx="12" cy="12" r="2.05" />
        <ellipse
          cx="12"
          cy="12"
          fill="none"
          stroke="currentColor"
          stroke-width="1.15"
          rx="10"
          ry="3.8"
        />
        <ellipse
          cx="12"
          cy="12"
          fill="none"
          stroke="currentColor"
          stroke-width="1.15"
          rx="10"
          ry="3.8"
          transform="rotate(60 12 12)"
        />
        <ellipse
          cx="12"
          cy="12"
          fill="none"
          stroke="currentColor"
          stroke-width="1.15"
          rx="10"
          ry="3.8"
          transform="rotate(120 12 12)"
        />
      </svg>
    )
  }
  {
    name === "brain" && (
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none">
        <path
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M9.5 4.5a3 3 0 0 0-3 3v.5A3.5 3.5 0 0 0 4 11.5v1A3.5 3.5 0 0 0 6.5 16v.5a3 3 0 0 0 3 3M14.5 4.5a3 3 0 0 1 3 3v.5A3.5 3.5 0 0 1 20 11.5v1a3.5 3.5 0 0 1-2.5 3.5v.5a3 3 0 0 1-3 3M12 4.5v15"
        />
        <path
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          d="M9 9.5c0 1.5 1.2 2.5 3 2.5s3-1 3-2.5M9 14c0 1.2 1.2 2 3 2s3-.8 3-2"
        />
      </svg>
    )
  }
  {
    name === "ux" && (
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none">
        <rect
          x="3"
          y="4"
          width="18"
          height="14"
          rx="2"
          stroke="currentColor"
          stroke-width="1.5"
        />
        <path
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          d="M8 20h8M12 18v2"
        />
        <path
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M7.5 9.5 10 12l2.5-2 4 4"
        />
        <circle cx="16" cy="8" r="1" fill="currentColor" />
      </svg>
    )
  }
</span>

<style>
  .skill-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    color: var(--color-primary);
  }

  .skill-icon :global(svg) {
    width: 100%;
    height: 100%;
  }
</style>
