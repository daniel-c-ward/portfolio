---
export interface Props {
  year: string;
  title: string;
  position: string;
  description: string;
  casestudies?: string[];
}

const { year, title, position, description, casestudies } = Astro.props;

const parseCaseStudy = (casestudy: string) => {
  const match = casestudy.match(/^\[([^\]]+)\]\(([^)]+)\)$/);

  if (!match) {
    return { text: casestudy };
  }

  const [, text, href] = match;
  const resolvedHref = href.startsWith("./")
    ? `/work/${href.replace(/^\.\//, "").replace(/\.mdx?$/, "")}`
    : href;

  return { text, href: resolvedHref };
};
---

<div class="cv-card content-card">
  <div class="cv-card__body content-card__body">
    <div class="cv-card__header">
      <span class="content-card__label">{year}</span>
      <h3 class="cv-card__title">{title}</h3>
      <p class="cv-card__position">{position}</p>
    </div>
    <p class="cv-card__description">{description}</p>

    {
      casestudies && casestudies.length > 0 && (
        <div class="cv-card__casestudies">
          <p class="cv-card__casestudies-title">Related Work:</p>
          <div class="cv-card__casestudies-list">
            {casestudies.map((casestudy) => {
              const parsedCaseStudy = parseCaseStudy(casestudy);

              return (
                <span class="case-study-card">
                  {parsedCaseStudy.href ? (
                    <a class="work-link" href={parsedCaseStudy.href}>
                      {parsedCaseStudy.text}
                    </a>
                  ) : (
                    <span class="prose">{parsedCaseStudy.text}</span>
                  )}
                </span>
              );
            })}
          </div>
        </div>
      )
    }
  </div>
</div>

<style>
  a.work-link {
    color: var(--color-primary);
    text-decoration: none;
    font-weight: 500;
  }
</style>
