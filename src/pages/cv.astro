---
import PageLayout from "../layouts/PageLayout.astro";
import Timeline from "../components/Timeline.astro";
import InfoCards from "../components/InfoCards.astro";
import { skills } from "../config/skills";
import {
  entriesFromModules,
  mergeTimelineEntries,
  type CvFrontmatter,
} from "../lib/cv-entries";

const experienceModules = import.meta.glob<{ frontmatter: CvFrontmatter }>(
  "../content/experience/*.md",
  { eager: true },
);
const educationModules = import.meta.glob<{ frontmatter: CvFrontmatter }>(
  "../content/education/*.md",
  { eager: true },
);

const timelineEntries = mergeTimelineEntries(
  entriesFromModules(experienceModules, "experience"),
  entriesFromModules(educationModules, "education"),
);
---

<PageLayout
  title="Daniel Ward | CV"
  description="Daniel Ward's Curriculum Vitae - Experience and Education."
>
  <div class="cv-page page">
    <div class="page-hero">
      <p class="eyebrow">Curriculum Vitae</p>
      <h1>Daniel Ward</h1>
      <p class="lead">
        This is my CV with the option of downloading the pdf version, and then
        some extra information at the end.
      </p>
      <a
        href="/Ward-Daniel-CV.pdf"
        class="button button--primary"
        onclick="umami('cv-download')"
        download
      >
        <svg
          class="icon-download"
          aria-hidden="true"
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
          <polyline points="7 10 12 15 17 10"></polyline>
          <line x1="12" y1="15" x2="12" y2="3"></line>
        </svg>
        Download My CV (PDF)
      </a>
    </div>

    <section class="cv-section" aria-labelledby="skills-heading">
      <h2 id="skills-heading">Skills</h2>
      <InfoCards items={skills} layout="grid" columns={2} />
    </section>

    <section class="cv-section" aria-labelledby="timeline-heading">
      <h2 id="timeline-heading">Experience &amp; Education</h2>
      <Timeline entries={timelineEntries} />
    </section>
    <section>
      <h2>Character References</h2>
      <h3>Nolwenn Miniot (French Teacher and Form Tutor)</h3>
      <div class="pdf-container">
        <object
          data="Daniel Ward Reference.pdf"
          type="application/pdf"
          width="100%"
          height="600px"
        >
          <p>Your browser does not support inline PDFs.</p>
          <a href="Daniel Ward Reference.pdf" class="download-btn" download>
            Click here to download and view the PDF instead.
          </a>
        </object>
      </div>
    </section>
  </div>
</PageLayout>

<style>
  .pdf-container {
    width: 100%;
    max-width: 800px;
    margin: 0 auto;
    border: 1px solid #ccc;
    border-radius: 8px;
    overflow: hidden;
  }
  .download-btn {
    display: inline-block;
    padding: 10px 20px;
    background-color: var(--color-primary);
    color: var(--color-background);
    text-decoration: none;
    border-radius: 4px;
    margin-top: 10px;
  }
</style>
