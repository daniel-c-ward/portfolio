---
import PageLayout from "../layouts/PageLayout.astro";
import CvCard from "../components/CvCard.astro";

const experienceModules = import.meta.glob("../content/experience/*.md", {
  eager: true,
});
const educationModules = import.meta.glob("../content/education/*.md", {
  eager: true,
});

// Helper to safely extract metadata and sort
const extractEntries = (modules: Record<string, any>) => {
  return Object.values(modules)
    .map((mod) => ({
      ...mod.frontmatter,
    }))
    .sort((a, b) => {
      // Simple sort by year descending if possible, or string compare
      return String(b.year).localeCompare(String(a.year));
    });
};

const experience = extractEntries(experienceModules);
const education = extractEntries(educationModules);
---

<PageLayout
  title="Daniel Ward | CV"
  description="Daniel Ward's Curriculum Vitae - Experience and Education."
>
  <div class="cv-page page">
    <div class="page-hero">
      <p class="eyebrow">Curriculum Vitae</p>
      <h1>Daniel Ward</h1>
      <p class="lead">
        This is my CV with the option of downloading the pdf version, and then
        some extra information at the end.
      </p>
      <p></p>
      <a href="/Ward-Daniel-CV.pdf" class="button button--primary" download>
        <svg
          class="icon-download"
          aria-hidden="true"
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
          <polyline points="7 10 12 15 17 10"></polyline>
          <line x1="12" y1="15" x2="12" y2="3"></line>
        </svg>
        Download My CV (PDF)
      </a>
    </div>

    <section class="cv-section">
      <hr />
      <h2>Experience</h2>
      <div class="cv-grid">
        {
          experience.map((item) => (
            <CvCard
              year={item.year}
              title={item.title}
              position={item.position}
              description={item.description}
              casestudies={item.casestudies}
            />
          ))
        }
      </div>
    </section>

    <section class="cv-section">
      <h2>Education</h2>
      <div class="cv-grid">
        {
          education.map((item) => (
            <CvCard
              year={item.year}
              title={item.title}
              position={item.position}
              description={item.description}
            />
          ))
        }
      </div>
    </section>
  </div>
</PageLayout>
