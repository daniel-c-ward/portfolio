---
import PageLayout from "../layouts/PageLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import ProjectDivider from "../components/ProjectDivider.astro";
import { entriesFromGlob, type MdModule } from "../lib/md-entries";

const modules = import.meta.glob<MdModule>("../content/work/**/*.md", {
  eager: true,
});
const entries = entriesFromGlob(modules, "work");
const basePath = "/work";
---

<PageLayout
  title="Daniel Ward | Work"
  description="Projects and case studies by Daniel Ward."
>
  <div class="page">
    <header class="page-hero">
      <p class="eyebrow">Work</p>
      <h1>Projects</h1>
      <p class="lead">
        Here are a list of my projects made for real clients. They are mostly
        accompanied by case studies that go into more detail about the project,
        the process, and the outcome.
      </p>
    </header>

    {
      entries.length === 0 ? (
        <p class="lead">No work entries yet.</p>
      ) : (
        <section class="project-showcase" aria-label="Work projects">
          <ProjectDivider
            to={entries[0]}
            index={0}
            fromLight="var(--color-background)"
            fromDark="var(--color-background)"
            fromStrokeLight="var(--color-primary)"
            fromStrokeDark="var(--color-primary)"
          />
          {
            entries.flatMap((entry, index) => [
              index > 0 ? (
                <ProjectDivider
                  from={entries[index - 1]}
                  to={entry}
                  index={index}
                />
              ) : null,
              <ProjectCard
                item={entry}
                basePath={basePath}
                isCompact={false}
                index={index}
                inCarousel={false}
              />,
            ])
          }
          {
            entries.length > 0 && (
              <ProjectDivider
                from={entries[entries.length - 1]}
                index={entries.length}
                toLight="var(--color-background)"
                toDark="var(--color-background)"
                toStrokeLight="var(--color-primary)"
                toStrokeDark="var(--color-primary)"
              />
            )
          }
        </section>
      )
    }
  </div>
</PageLayout>
