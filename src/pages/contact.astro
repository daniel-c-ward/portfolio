---
import PageLayout from "../layouts/PageLayout.astro";

/** Update these with your actual contact information. */
const contact = {
  linkedin: "https://www.linkedin.com/in/yourprofile",
  instagram: "https://www.instagram.com/yourprofile",
  email: "danielclarkward@gmail.com",
  phone: "+441234567890",
  phoneDisplay: "+44 1234 567890",
};
---

<PageLayout
  title="Contact | Daniel Ward"
  description="Email Daniel Ward for inquiries and collaborations."
>
  <div class="page">
    <header class="page-hero">
      <p class="eyebrow">Contact</p>
      <h1>Email</h1>
      <p class="lead">Reach me directly at the address below.</p>
    </header>

    <section class="content-section" aria-labelledby="email-heading">
      <h2 id="email-heading">Send an email</h2>
      <p>
        <a href={`mailto:${contact.email}`} class="text-link">{contact.email}</a
        >
      </p>
    </section>
  </div>
</PageLayout>
