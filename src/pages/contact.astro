---
import PageLayout from "../layouts/PageLayout.astro";

/** Update these with your actual contact information. */
const contact = {
  linkedin: "https://www.linkedin.com/in/yourprofile",
  instagram: "https://www.instagram.com/yourprofile",
  email: "contact@example.com",
  phone: "+441234567890",
  phoneDisplay: "+44 1234 567890",
};
---

<PageLayout
  title="Contact | Daniel Ward"
  description="Get in touch with Daniel Ward - email, phone, and social links."
>
  <div class="page">
    <header class="page-hero">
      <p class="eyebrow">Contact</p>
      <h1>Get in touch</h1>
      <p class="lead">
        Questions about work, collaborations, or speaking - reach out by email, phone, or the links below.
      </p>
    </header>

    <section class="content-section contact-connect" aria-labelledby="connect-heading">
      <h2 id="connect-heading">Connect</h2>
      <ul class="connect-list">
        <li>
          <a class="connect-link" href={contact.linkedin} rel="noopener noreferrer" target="_blank">
            <span class="connect-link__icon" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                <path
                  d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
                ></path>
              </svg>
            </span>
            <span class="connect-link__label">LinkedIn</span>
            <span class="connect-link__value">linkedin.com/in/danielward</span>
          </a>
        </li>
        <li>
          <a class="connect-link" href={contact.instagram} rel="noopener noreferrer" target="_blank">
            <span class="connect-link__icon" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                <path
                  d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881z"
                ></path>
              </svg>
            </span>
            <span class="connect-link__label">Instagram</span>
            <span class="connect-link__value">@danielward</span>
          </a>
        </li>
        <li>
          <a class="connect-link" href={`mailto:${contact.email}`}>
            <span class="connect-link__icon" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect width="20" height="16" x="2" y="4" rx="2"></rect>
                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
              </svg>
            </span>
            <span class="connect-link__label">Email</span>
            <span class="connect-link__value">{contact.email}</span>
          </a>
        </li>
        <li>
          <a class="connect-link" href={`tel:${contact.phone.replace(/\s/g, "")}`}>
            <span class="connect-link__icon" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path
                  d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"
                ></path>
              </svg>
            </span>
            <span class="connect-link__label">Phone</span>
            <span class="connect-link__value">{contact.phoneDisplay}</span>
          </a>
        </li>
      </ul>
    </section>

    <section class="content-section contact-form-section" aria-labelledby="form-heading">
      <h2 id="form-heading">Send a message</h2>
      <p class="form-note">
        This form opens your email client (static demo). Replace the <code>action</code> with Formspree, Netlify Forms, or your own endpoint when you are ready.
      </p>
      <form
        class="contact-form"
        action={`mailto:${contact.email}`}
        method="post"
        enctype="text/plain"
      >
        <div class="form-field">
          <label for="contact-name">Name <span class="required">(required)</span></label>
          <input
            type="text"
            id="contact-name"
            name="name"
            autocomplete="name"
            required
          />
        </div>
        <div class="form-field">
          <label for="contact-email">Email <span class="required">(required)</span></label>
          <input
            type="email"
            id="contact-email"
            name="email"
            autocomplete="email"
            required
          />
        </div>
        <div class="form-field">
          <label for="contact-subject">Subject</label>
          <input type="text" id="contact-subject" name="subject" autocomplete="off" />
        </div>
        <div class="form-field">
          <label for="contact-message">Message <span class="required">(required)</span></label>
          <textarea id="contact-message" name="message" rows="6" required></textarea>
        </div>
        <button type="submit" class="button button--primary form-submit">Send message</button>
      </form>
    </section>
  </div>
</PageLayout>
