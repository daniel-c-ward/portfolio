---
import PageLayout from "../layouts/PageLayout.astro";
import InfoCards from "../components/InfoCards.astro";
import { contactInfo, socialUrls } from "../config/contact";

const contactCards = [
  {
    title: "Email",
    description:
      "Send me a direct message for inquiries and collaborations.",
    link: { href: socialUrls.email, label: contactInfo.email },
  },
  {
    title: "LinkedIn",
    description:
      "Connect with me on LinkedIn to see my professional profile and updates.",
    link: {
      href: socialUrls.linkedin,
      label: "Visit LinkedIn →",
      external: true,
    },
  },
];
---

<PageLayout
  title="Contact | Daniel Ward"
  description="Get in touch with Daniel Ward via email or LinkedIn."
>
  <div class="page">
    <header class="page-hero">
      <p class="eyebrow">Contact</p>
      <h1>Let's Connect</h1>
      <p class="lead">Reach out through your preferred channel.</p>
    </header>

    <InfoCards items={contactCards} label="Contact options" />
  </div>
</PageLayout>

<style>
  :global(.page .info-cards) {
    margin-top: 3rem;
  }
</style>
