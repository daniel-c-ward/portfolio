---
import PageLayout from "../../layouts/PageLayout.astro";
import {
  entriesFromGlob,
  slugFromPath,
  type MdModule,
} from "../../lib/md-entries";

export function getStaticPaths() {
  const modules = import.meta.glob<MdModule>("../../content/work/**/*.md", {
    eager: true,
  });
  const entries = entriesFromGlob(modules, "work");

  return entries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry, modules },
  }));
}

const { entry, modules } = Astro.props;
const mod = Object.entries(modules).find(
  ([path]) => slugFromPath(path, "work") === entry.slug,
)?.[1];
const demoUrl = entry.url?.startsWith("http")
  ? entry.url
  : entry.url
    ? `https://${entry.url}`
    : undefined;
const formattedDate =
  entry.date &&
  new Date(entry.date).toLocaleDateString("en-GB", {
    year: "numeric",
    month: "short",
    day: "numeric",
  });
---

<PageLayout
  title={`Work | ${entry.title}`}
  description={entry.description ?? entry.title}
>
  <article class="page page-hero case-study">
    <a class="back-link" href="/work"><- Back to work</a>
    <header class="case-study__header">
      <p class="eyebrow">Work</p>
      <h1>{entry.title}</h1>
      {formattedDate && <p class="work-date">{formattedDate}</p>}
      {entry.description && <p class="lead">{entry.description}</p>}
      <dl class="content-card__meta">
        <dt>Tags</dt>
        <dd>
          {
            entry.tags.length > 0 && (
              <footer class="content-card__tags" aria-label="Tags">
                {entry.tags.map((tag) => (
                  <span class="content-card__tag">{tag}</span>
                ))}
              </footer>
            )
          }
        </dd>
        {
          entry.challenge && (
            <>
              <dt>Challenge</dt>
              <dd>{entry.challenge}</dd>
            </>
          )
        }
        {
          entry.solution && (
            <>
              <dt>Solution</dt>
              <dd>{entry.solution}</dd>
            </>
          )
        }
        {
          entry.impact && (
            <>
              <dt>Impact</dt>
              <dd>{entry.impact}</dd>
            </>
          )
        }
        <dt>Tech Stack</dt>
        <dd>
          {
            entry.tools.length > 0 && (
              <footer class="content-card__tags" aria-label="Tech Stack">
                {entry.tools.map((tool) => (
                  <span class="content-card__tag">{tool}</span>
                ))}
              </footer>
            )
          }
        </dd>
      </dl>
      {
        entry.hasLiveDemo && demoUrl && (
          <footer class="content-card__actions">
            <a
              class="button button--secondary"
              href={demoUrl}
              target="_blank"
              rel="noreferrer"
            >
              View Site
            </a>
          </footer>
        )
      }
    </header>
    <div class="prose">
      {mod && <mod.Content />}
    </div>
  </article>
</PageLayout>
