---
import PageLayout from "../layouts/PageLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { entriesFromGlob, type MdModule } from "../lib/md-entries";

const modules = import.meta.glob<MdModule>("../content/lab/**/*.md", {
  eager: true,
});
const items = entriesFromGlob(modules, "lab");
---

<PageLayout
  title="Lab | Daniel Ward"
  description="Notes, experiments, and prototypes from Daniel Ward."
>
  <div class="page">
    <header class="page-hero">
      <p class="eyebrow">Lab</p>
      <h1>Lab</h1>
      <p class="lead">
        Small personal projects where I experiment with new techniques, tools, and ideas.
      </p>
    </header>

    {
      items.length === 0 ? (
        <p class="lead">There are currently no lab entries.</p>
      ) : (
        <section class="lab-collection" aria-label="Lab projects">
          {items.map((item, index) => (
            <ProjectCard
              item={item}
              basePath="/lab"
              isCompact={true}
              index={index}
              inCarousel={false}
              actionLabel="Case Study"
            />
          ))}
        </section>
      )
    }
  </div>
</PageLayout>
