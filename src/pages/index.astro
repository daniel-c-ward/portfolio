---
import PageLayout from "../layouts/PageLayout.astro";
import Accordion from "../components/Accordion.astro";
import Carousel from "../components/Carousel.astro";
import { entriesFromGlob, type MdModule } from "../lib/md-entries";

const aboutAccordions = [
  {
    id: "ai",
    title: "How I Use AI",
    content: `
    <p>I follow a structured AI workflow (a variation of Matt Pocock's 7-phase system) that alternates between human-led decisions and agent-led execution, keeping every session in the smart zone.</p>

    <ol>
      <li><strong>Idea</strong>: <em>I define the problem and desired outcome, then use AI to explore possibilities and refine the concept so we both have a shared design concept.</em></li>
      <li><strong>Research</strong>: <em>I explore questions and hypotheses using AI to gather insights and validate assumptions.</em></li>
      <li><strong>Prototype</strong>: <em>I use Gemini with canvas to create very quick prototypes; I also use CLI AI to create higher quality ones for finding issues before implementation.</em></li>
      <li><strong>Spec</strong>: <em>Using a skill, I convert the idea, research, and prototype into a detailed specification.</em></li>
      <li><strong>Kanban Board</strong>: <em>I use a skill to translate the spec into actionable tasks.</em></li>
      <li><strong>Execution</strong>: <em>AI implements each task from the Kanban Board, with a fresh context window for each one.</em></li>
      <li><strong>QA</strong>: <em>I review the implementation, ensuring tests pass and the user experience is satisfactory.</em></li>
    </ol>
  `,
  },

  {
    id: "design",
    title: "My design approach",
    content: `<p>I start with rough shape and layout using a canvas tool like tldraw or Excalidraw. Once the structure feels right I convert to Penpot or Figma for proper design work, then use AI to generate a clickable prototype.</p>
<p>I prioritise simplicity, usability, and clarity; interfaces should feel obvious in use and honest about what they ask of people.</p>`,
  },
];

const HOME_LAB_LIMIT = 5;

const workModules = import.meta.glob<MdModule>("../content/work/**/*.md", {
  eager: true,
});
const labModules = import.meta.glob<MdModule>("../content/lab/**/*.md", {
  eager: true,
});
const workItems = entriesFromGlob(workModules, "work");
const labItems = entriesFromGlob(labModules, "lab").slice(0, HOME_LAB_LIMIT);
---

<PageLayout
  title="Daniel Ward | Portfolio"
  description="Daniel Ward - UX and behavioural economics. Websites for how people decide."
>
  <div class="home-intro">
    <section class="hero" aria-labelledby="hero-heading">
      <div class="hero__inner page">
        <p class="hero__wordmark">Daniel Ward</p>
        <h1 id="hero-heading">
          Products designed for how people actually decide, using behavioural economics.
        </h1>
        <p class="hero__lead">
          UX and behavioural economics; I build websites and systems that align
          with how people think, decide, and act.
        </p>
        <div class="hero__actions">
          <a class="button button--secondary" href="/work">View work</a>
          <a class="button button--primary" href="/cv">View my CV</a>
        </div>
      </div>
    </section>

    <section id="about" class="about page">
      <h2>About</h2>
      <p>
        I am a website developer with a passionate interest in behavioural
        economics and cognitive science. Thus, I approach design with a focus on
        UX and how to create interfaces that are intuitive, engaging, and
        aligned with users' goals and biases.
      </p>
      <Accordion items={aboutAccordions} />
      <a href="/cv" class="text-link home-link">Read more on my CV -></a>
    </section>

    <section id="work" class="home-block page">
      <h2>Work</h2>
      <p>Selected projects and case studies.</p>
      {
        workItems.length > 0 ? (
          <Carousel
            items={workItems}
            basePath="/work"
            id="home-work-carousel"
            label="Work projects"
            isCompact={true}
          />
        ) : (
          <p class="home-empty">There are currently no lab entries.</p>
        )
      }
      <a class="text-link home-link" href="/work">View all work -></a>
    </section>

    <section id="lab" class="home-block page">
      <h2>Lab</h2>
      <p>Notes, experiments, and works in progress.</p>
      {
        labItems.length > 0 ? (
          <Carousel
            items={labItems}
            basePath="/lab"
            id="home-lab-carousel"
            label="Lab projects"
            isCompact={true}
            actionLabel="Case Study"
          />
        ) : (
          <p class="home-empty">There are currently no lab entries.</p>
        )
      }
      <a class="text-link home-link" href="/lab">View the lab -></a>
    </section>
  </div>
</PageLayout>
