---
import PageLayout from "../layouts/PageLayout.astro";
import Accordion from "../components/Accordion.astro";
import Carousel from "../components/Carousel.astro";
import { entriesFromGlob, type MdModule } from "../lib/md-entries";

const aboutAccordions = [
  {
    id: "ai",
    title: "How I Use AI",
    content: `
    <p>I follow a structured AI workflow — a variation of Matt Pocock's 7-phase system — that alternates between human-led decisions and agent-led execution. I define the problem and desired outcome, then use AI for research and rapid prototyping. Once the spec is locked, AI handles implementation task by task while I review and QA each one.</p>
  `,
  },

  {
    id: "design",
    title: "My design approach",
    content: `<p>I start with rough shape and layout using a canvas tool like tldraw or Excalidraw. Once the structure feels right I convert to Penpot or Figma for proper design work, then use AI to generate a clickable prototype.</p>
<p>I prioritise simplicity, usability, and clarity — interfaces should feel obvious in use and honest about what they ask of people.</p>`,
  },

  {
    id: "tools",
    title: "Tools & stack",
    content: `<p>I work across the full stack with a lean, focused toolset:</p>
<ul>
<li><strong>Design:</strong> tldraw / Excalidraw for rough layouts, Penpot / Figma for polished design</li>
<li><strong>Frontend:</strong> Astro, React, TypeScript</li>
<li><strong>Backend:</strong> Node.js, Go</li>
<li><strong>AI:</strong> opencode, Gemini, Pi</li>
<li><strong>Version control:</strong> Git and GitHub</li>
<li><strong>Deployment:</strong> Vercel, static hosting</li>
</ul>`,
  },
];

const HOME_LAB_LIMIT = 5;

const workModules = import.meta.glob<MdModule>("../content/work/**/*.md", {
  eager: true,
});
const labModules = import.meta.glob<MdModule>("../content/lab/**/*.md", {
  eager: true,
});
const workItems = entriesFromGlob(workModules, "work");
const labItems = entriesFromGlob(labModules, "lab").slice(0, HOME_LAB_LIMIT);
---

<PageLayout
  title="Daniel Ward | Portfolio"
  description="Daniel Ward - Behavioural product design for how people actually decide."
>
  <div class="home-intro">
    <section class="hero" aria-labelledby="hero-heading">
      <div class="hero__inner page">
        <p class="hero__wordmark">Daniel Ward</p>
        <h1 id="hero-heading">Products built around how people actually decide — not how we wish they did.</h1>
        <p class="hero__lead">
          Backend, frontend, UX, UI — grounded in behavioural science.
        </p>
        <div class="hero__actions">
          <a class="button button--secondary" href="/work">View work</a>
          <a class="button button--primary" href="/cv">View my CV</a>
        </div>
      </div>
    </section>

    <section id="about" class="about page">
      <h2>About</h2>
      <p>
        I am a website developer with a passionate interest in behavioural
        economics and cognitive science. Thus, I approach design with a focus on
        UX and how to create interfaces that are intuitive, engaging, and
        aligned with users' goals and biases.
      </p>
      <Accordion items={aboutAccordions} />
      <a href="/cv" class="text-link home-link">Read more on my CV -></a>
    </section>

    <section id="work" class="home-block page">
      <h2>Work</h2>
      <p>Selected projects and case studies.</p>
      {
        workItems.length > 0 ? (
          <Carousel
            items={workItems}
            basePath="/work"
            id="home-work-carousel"
            label="Work projects"
            isCompact={true}
          />
        ) : (
          <p class="home-empty">There are currently no work entries.</p>
        )
      }
      <a class="text-link home-link" href="/work">View all work -></a>
    </section>

    <section id="lab" class="home-block page">
      <h2>Lab</h2>
      <p>Notes, experiments, and works in progress.</p>
      {
        labItems.length > 0 ? (
          <Carousel
            items={labItems}
            basePath="/lab"
            id="home-lab-carousel"
            label="Lab projects"
            isCompact={true}
            actionLabel="View Section"
            getHref={(item) => `/lab/${item.section}`}
          />
        ) : (
          <p class="home-empty">There are currently no lab entries.</p>
        )
      }
      <a class="text-link home-link" href="/lab">View the lab -></a>
    </section>
  </div>
</PageLayout>
